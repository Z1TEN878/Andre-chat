import kivy
kivy.require('2.1.0')

from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.label import Label
from kivy.uix.button import Button
from kivy.uix.textinput import TextInput
from kivy.uix.scrollview import ScrollView
from kivy.clock import Clock
from kivy.graphics import Color, Rectangle, Line
from kivy.core.window import Window
from kivy.uix.screenmanager import ScreenManager, Screen
from kivy.uix.popup import Popup
from kivy.metrics import dp

import threading
import datetime
import asyncio
import random

try:
    import websockets
    WS_AVAILABLE = True
except ImportError:
    WS_AVAILABLE = False

SERVER_URL = "wss://retro-chat-76hm.onrender.com"

# ==========================================
# ЭКРАН ЗАСТАВКИ (SPLASH)
# ==========================================
class SplashScreen(Screen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        
        # Фон
        with self.canvas.before:
            Color(0.56, 0.79, 0.98, 1) # #90CAF9
            self.rect = Rectangle(pos=self.pos, size=self.size)
        self.bind(pos=self.update_rect, size=self.update_rect)

        layout = BoxLayout(orientation='vertical', padding=dp(50))
        
        # Рисуем много толстых кругов по ВСЕМУ экрану
        with self.canvas.before:
            Color(0.7, 0.85, 0.98, 0.8) 
            w = Window.width
            h = Window.height
            
            for _ in range(50):
                x = random.uniform(0, w) 
                y = random.uniform(0, h) 
                r = random.uniform(10, 80) 
                Line(circle=(x, y, r), width=3) 

        layout.add_widget(Label(
            text="Загрузка...", font_size=dp(24), bold=True,
            color=(0.05, 0.28, 0.63, 1) 
        ))
        
        self.add_widget(layout)

    def update_rect(self, *args):
        self.rect.pos = self.pos
        self.rect.size = self.size

    def on_enter(self):
        Clock.schedule_once(self.go_to_chat, 2)

    def go_to_chat(self, dt):
        self.manager.current = 'chat'

# ==========================================
# ЭКРАН ЧАТА
# ==========================================
class ChatScreen(Screen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        
        self.ws = None
        self.loop = None
        self.is_connected = False
        self.my_name = "Вы"
        self.long_press_event = None
        self.selected_msg_widget = None

        # Основной фон
        with self.canvas.before:
            Color(0.56, 0.79, 0.98, 1)
            self.rect = Rectangle(pos=self.pos, size=self.size)
        self.bind(pos=self.update_rect, size=self.update_rect)

        main_layout = BoxLayout(orientation='vertical')

        # --- ВЕРХНЯЯ ПАНЕЛЬ (Статус) ---
        self.top_bar = BoxLayout(size_hint_y=None, height=dp(50), padding=dp(5))
        with self.top_bar.canvas.before:
            self.status_color = Color(0.83, 0.18, 0.18, 1) 
            self.top_rect = Rectangle(pos=self.top_bar.pos, size=self.top_bar.size)
        self.top_bar.bind(
            pos=lambda *a: setattr(self.top_rect, 'pos', self.top_bar.pos),
            size=lambda *a: setattr(self.top_rect, 'size', self.top_bar.size)
        )
        
        self.status_label = Label(text="Статус: Отключено", color=(1, 1, 1, 1), bold=True, font_size=dp(16))
        self.top_bar.add_widget(self.status_label)
        main_layout.add_widget(self.top_bar)

        # --- ОБЛАСТЬ ЧАТА ---
        self.scroll = ScrollView(size_hint=(1, 1), do_scroll_x=False)
        with self.scroll.canvas.before:
            Color(0.88, 0.96, 0.99, 1) 
            self.scroll_rect = Rectangle(pos=self.scroll.pos, size=self.scroll.size)
        self.scroll.bind(
            pos=lambda *a: setattr(self.scroll_rect, 'pos', self.scroll.pos),
            size=lambda *a: setattr(self.scroll_rect, 'size', self.scroll.size)
        )
        
        self.chat_box = BoxLayout(orientation='vertical', size_hint_y=None, spacing=dp(5), padding=dp(10))
        self.chat_box.bind(minimum_height=self.chat_box.setter('height'))
        self.scroll.add_widget(self.chat_box)
        main_layout.add_widget(self.scroll)

        # --- НАСТРОЙКИ ---
        self.settings_box = BoxLayout(orientation='vertical', size_hint_y=None, height=dp(150), padding=dp(5), spacing=dp(3))
        with self.settings_box.canvas.before:
            Color(0.8, 0.88, 0.95, 1)
            self.settings_rect = Rectangle(pos=self.settings_box.pos, size=self.settings_box.size)
        self.settings_box.bind(
            pos=lambda *a: setattr(self.settings_rect, 'pos', self.settings_box.pos),
            size=lambda *a: setattr(self.settings_rect, 'size', self.settings_box.size)
        )

        # Ник
        name_row = BoxLayout(size_hint_y=None, height=dp(40), spacing=dp(5))
        name_row.add_widget(Label(text="Ник:", color=(0, 0, 0, 1), size_hint_x=0.2))
        self.name_entry = TextInput(text="Вы", multiline=False, size_hint_x=0.8, font_size=dp(14))
        name_row.add_widget(self.name_entry)
        self.settings_box.add_widget(name_row)

        # Кнопки подключения и выхода
        btn_row = BoxLayout(size_hint_y=None, height=dp(40), spacing=dp(5))
        self.btn_connect = Button(text="Подключиться", background_color=(0.26, 0.65, 0.96, 1), font_size=dp(14))
        self.btn_connect.bind(on_press=self.start_client)
        btn_row.add_widget(self.btn_connect)

        self.btn_exit = Button(text="Выйти", background_color=(0.72, 0.11, 0.11, 1), font_size=dp(14), disabled=True)
        self.btn_exit.bind(on_press=self.confirm_exit)
        btn_row.add_widget(self.btn_exit)
        self.settings_box.add_widget(btn_row)

        # Кнопка очистки
        self.btn_clear = Button(text="Очистить чат", size_hint_y=None, height=dp(35), background_color=(0.39, 0.71, 0.96, 1), font_size=dp(12))
        self.btn_clear.bind(on_press=self.ask_clear_mode)
        self.settings_box.add_widget(self.btn_clear)
        main_layout.add_widget(self.settings_box)

        # --- ПАНЕЛЬ ВВОДА ---
        self.bottom_bar = BoxLayout(size_hint_y=None, height=dp(55), padding=dp(5), spacing=dp(5))
        
        self.msg_entry = TextInput(hint_text="Сообщение...", multiline=False, disabled=True, font_size=dp(14))
        self.msg_entry.bind(on_text_validate=self.send_message)
        self.bottom_bar.add_widget(self.msg_entry)

        # КНОПКА ОТПРАВИТЬ (ИСПРАВЛЕНА)
        self.send_btn = Button(
            text="Отпр.", 
            size_hint_x=None, 
            width=dp(80), # Увеличили ширину
            disabled=True, 
            background_color=(0.1, 0.4, 0.7, 1), # Сделали темнее
            font_size=dp(14), 
            bold=True
        )
        self.send_btn.bind(on_press=self.send_message)
        self.bottom_bar.add_widget(self.send_btn)
        
        main_layout.add_widget(self.bottom_bar)
        self.add_widget(main_layout)

        self.add_message("Система", f"Адрес: {SERVER_URL}")
        self.add_message("Система", "Введите Ник и нажмите 'Подключиться'.")

    def update_rect(self, *args):
        self.rect.pos = self.pos
        self.rect.size = self.size

    # --- ДОБАВЛЕНИЕ СООБЩЕНИЙ ---
    def add_message(self, sender, text):
        Clock.schedule_once(lambda dt: self._add_message_ui(sender, text))

    def _add_message_ui(self, sender, text):
        time_now = datetime.datetime.now().strftime("%H:%M")
        
        if sender == "Система":
            msg_text = f"[{time_now}] *** {text} ***"
            color = (0.4, 0.4, 0.4, 1)
        else:
            msg_text = f"[{time_now}] {sender}: {text}"
            color = (0, 0, 0, 1)

        lbl = Label(
            text=msg_text, color=color, font_size=dp(14),
            size_hint_y=None, halign="left", valign="top",
            text_size=(Window.width - dp(40), None)
        )
        lbl.bind(texture_size=lbl.setter('size'))
        
        lbl.bind(on_touch_down=self.on_msg_touch_down)
        lbl.bind(on_touch_up=self.on_msg_touch_up)
        lbl.msg_text = msg_text 

        self.chat_box.add_widget(lbl)
        Clock.schedule_once(lambda dt: setattr(self.scroll, 'scroll_y', 0), 0.05)

    # --- ДОЛГОЕ НАЖАТИЕ НА СООБЩЕНИЕ ---
    def on_msg_touch_down(self, instance, touch):
        if instance.collide_point(*touch.pos):
            self.selected_msg_widget = instance
            self.long_press_event = Clock.schedule_once(lambda dt: self.show_delete_popup(instance), 0.5)
        return True

    def on_msg_touch_up(self, instance, touch):
        if self.long_press_event:
            self.long_press_event.cancel()
            self.long_press_event = None

    # --- ОКНА ВЫБОРА (ПОПАПЫ) ---
    def show_delete_popup(self, msg_widget):
        content = BoxLayout(orientation='vertical', spacing=dp(10), padding=dp(10))
        content.add_widget(Label(text="Удалить сообщение?", font_size=dp(16)))
        
        btn_self = Button(text="Только у себя", size_hint_y=None, height=dp(50), background_color=(0.26, 0.65, 0.96, 1))
        btn_all = Button(text="У всех", size_hint_y=None, height=dp(50), background_color=(0.72, 0.11, 0.11, 1))
        btn_cancel = Button(text="Отмена", size_hint_y=None, height=dp(50), background_color=(0.5, 0.5, 0.5, 1))
        
        content.add_widget(btn_self)
        content.add_widget(btn_all)
        content.add_widget(btn_cancel)

        popup = Popup(title="Удаление", content=content, size_hint=(0.8, 0.4), auto_dismiss=True)

        def delete_local(instance):
            popup.dismiss()
            self.remove_msg_widget(msg_widget)

        def delete_all(instance):
            popup.dismiss()
            self.remove_msg_widget(msg_widget)
            if self.is_connected and self.ws and self.loop:
                sys_msg = f"__SYSTEM__:DELETE_ALL:{msg_widget.msg_text}"
                asyncio.run_coroutine_threadsafe(self.ws.send(sys_msg), self.loop)

        btn_self.bind(on_press=delete_local)
        btn_all.bind(on_press=delete_all)
        btn_cancel.bind(on_press=popup.dismiss)
        popup.open()

    def remove_msg_widget(self, widget):
        if widget in self.chat_box.children:
            self.chat_box.remove_widget(widget)

    def ask_clear_mode(self, instance):
        content = BoxLayout(orientation='vertical', spacing=dp(10), padding=dp(10))
        content.add_widget(Label(text="Очистить чат?", font_size=dp(16)))
        
        btn_self = Button(text="Только у себя", size_hint_y=None, height=dp(50), background_color=(0.26, 0.65, 0.96, 1))
        btn_all = Button(text="У всех", size_hint_y=None, height=dp(50), background_color=(0.72, 0.11, 0.11, 1))
        btn_cancel = Button(text="Отмена", size_hint_y=None, height=dp(50), background_color=(0.5, 0.5, 0.5, 1))
        
        content.add_widget(btn_self)
        content.add_widget(btn_all)
        content.add_widget(btn_cancel)

        popup = Popup(title="Очистка", content=content, size_hint=(0.8, 0.4), auto_dismiss=True)

        def clear_local(instance):
            popup.dismiss()
            self.chat_box.clear_widgets()
            self.add_message("Система", "История очищена только у вас.")

        def clear_all(instance):
            popup.dismiss()
            self.chat_box.clear_widgets()
            self.add_message("Система", "История очищена у всех.")
            if self.is_connected and self.ws and self.loop:
                sys_msg = f"__SYSTEM__:CLEAR_ALL:{self.my_name}"
                asyncio.run_coroutine_threadsafe(self.ws.send(sys_msg), self.loop)

        btn_self.bind(on_press=clear_local)
        btn_all.bind(on_press=clear_all)
        btn_cancel.bind(on_press=popup.dismiss)
        popup.open()

    def confirm_exit(self, instance):
        content = BoxLayout(orientation='vertical', spacing=dp(10), padding=dp(10))
        content.add_widget(Label(text="Выйти из чата?", font_size=dp(16)))
        
        btn_yes = Button(text="Да", size_hint_y=None, height=dp(50), background_color=(0.72, 0.11, 0.11, 1))
        btn_no = Button(text="Нет", size_hint_y=None, height=dp(50), background_color=(0.5, 0.5, 0.5, 1))
        
        content.add_widget(btn_yes)
        content.add_widget(btn_no)

        popup = Popup(title="Выход", content=content, size_hint=(0.8, 0.3), auto_dismiss=True)

        def do_exit(instance):
            popup.dismiss()
            self.disconnect()

        btn_yes.bind(on_press=do_exit)
        btn_no.bind(on_press=popup.dismiss)
        popup.open()

    # --- ЛОГИКА ПОДКЛЮЧЕНИЯ ---
    def set_connected_state(self, connected):
        self.is_connected = connected
        if connected:
            self.status_label.text = "Статус: В сети (Облако)"
            self.status_label.color = (0, 0, 0, 1)
            self.status_color.rgba = (0.30, 0.69, 0.31, 1) 
            self.msg_entry.disabled = False
            self.send_btn.disabled = False
            self.btn_connect.disabled = True
            self.btn_exit.disabled = False
            self.name_entry.disabled = True
        else:
            self.status_label.text = "Статус: Отключено"
            self.status_label.color = (1, 1, 1, 1)
            self.status_color.rgba = (0.83, 0.18, 0.18, 1) 
            self.msg_entry.disabled = True
            self.send_btn.disabled = True
            self.btn_connect.disabled = False
            self.btn_exit.disabled = True
            self.name_entry.disabled = False

    def start_client(self, instance):
        if not WS_AVAILABLE:
            self.add_message("Система", "Установите библиотеку websockets через Pip!")
            return

        self.my_name = self.name_entry.text.strip()
        if not self.my_name:
            self.add_message("Система", "Введите Ник!")
            return

        self.btn_connect.disabled = True
        self.add_message("Система", "Подключение...")
        threading.Thread(target=self.run_ws, daemon=True).start()

    def run_ws(self):
        self.loop = asyncio.new_event_loop()
        asyncio.set_event_loop(self.loop)

        async def connect():
            try:
                async with websockets.connect(SERVER_URL, open_timeout=60) as websocket:
                    self.ws = websocket
                    Clock.schedule_once(lambda dt: self.set_connected_state(True))
                    self.add_message("Система", "✅ Подключено!")

                    join_msg = f"__SYSTEM__:JOIN:{self.my_name}"
                    await websocket.send(join_msg)

                    async for message in websocket:
                        if message.startswith("__SYSTEM__:"):
                            parts = message.split(":")
                            if len(parts) >= 3:
                                action = parts[1]
                                data = parts[2]
                                if action == "JOIN":
                                    self.add_message("Система", f"{data} присоединился")
                                elif action == "EXIT":
                                    self.add_message("Система", f"{data} вышел")
                                elif action == "CLEAR_ALL":
                                    Clock.schedule_once(lambda dt: self.chat_box.clear_widgets())
                                    self.add_message("Система", f"{data} очистил чат у всех.")
                                elif action == "DELETE_ALL":
                                    self.add_message("Система", f"Сообщение удалено у всех.")
                        else:
                            self.add_message("Собеседник", message)

            except Exception as e:
                self.add_message("Система", f"❌ Ошибка: {e}")
            finally:
                self.ws = None
                Clock.schedule_once(lambda dt: self.set_connected_state(False))

        self.loop.run_until_complete(connect())

    def disconnect(self):
        if self.is_connected:
            if self.loop and self.ws:
                exit_msg = f"__SYSTEM__:EXIT:{self.my_name}"
                asyncio.run_coroutine_threadsafe(self.ws.send(exit_msg), self.loop)
                asyncio.run_coroutine_threadsafe(self.ws.close(), self.loop)
            self.add_message("Система", "Вы вышли из чата.")
            self.set_connected_state(False)

    def send_message(self, instance):
        text = self.msg_entry.text.strip()
        if text and self.is_connected and self.ws and self.loop:
            try:
                full_msg = f"{self.my_name}: {text}"
                asyncio.run_coroutine_threadsafe(self.ws.send(full_msg), self.loop)
                self.add_message(self.my_name, text)
                self.msg_entry.text = ""
            except Exception as e:
                self.add_message("Система", f"Ошибка: {e}")

# ==========================================
# ЗАПУСК ПРИЛОЖЕНИЯ
# ==========================================
class RetroMessengerApp(App):
    def build(self):
        self.title = "Ретро-Мессенджер"
        Window.clearcolor = (0.56, 0.79, 0.98, 1)
        
        sm = ScreenManager()
        sm.add_widget(SplashScreen(name='splash'))
        sm.add_widget(ChatScreen(name='chat'))
        return sm

if __name__ == "__main__":
    RetroMessengerApp().run()